# Panduan Deployment (Vercel & Lokal):
# Salin file ini menjadi .env.local untuk pengembangan lokal, atau atur pada Vercel Environment Variables / AI Studio Secrets.
VITE_GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Google Sheets API v4 Spreadsheet ID
VITE_SPREADSHEET_ID=your_google_spreadsheet_id_here

# Google Sign-In Client ID & OAuth2 (Google Identity Services)
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"
